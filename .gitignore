# Database dumps and env backups. The repository is PUBLIC — the previous
# root .gitignore covered these and the app-level one did not, so promoting
# this app to the root very nearly committed four clinic dumps.
/.backups/
*.bak
.env*.bak

# Supabase CLI scratch state (container secrets, link info). This app does not
# use Supabase migrations — it owns its schema in lib/server/db.ts.
/supabase/
