node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
.pnpm-store/

.env
.env.*
!.env.example

.vercel/
.supabase/

npm-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.idea/
.vscode/

# never commit real clinic data
/data/
/backups/
.backups/
*.dump
*.sql.gz

# ── secret material ─────────────────────────────────────────────
# mkcert LAN certificates (BUILD.md §1.3). A local CA private key in
# git history is tedious to scrub and trusted on both tablets.
*.pem
*.p12
/certs/
# age/gpg keys for the encrypted backups (HOSTING.md §5)
*.age
*.key
age.key*

# ── local Supabase (BUILD.md §1.2) ──────────────────────────────
# Note: supabase/config.toml and supabase/migrations/ ARE committed.
supabase/.branches/
supabase/.temp/

# ── build & deploy output ───────────────────────────────────────
.wrangler/
.open-next/

# ── generated service worker (TABLET.md §6) ─────────────────────
public/sw.js
public/sw.js.map
public/workbox-*.js
public/worker-*.js

# ── test output (BUILD.md §1.7) ─────────────────────────────────
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Deliberately NOT ignored, and must stay that way:
#   pnpm-lock.yaml        reproducible installs
#   supabase/migrations/  *.sql migrations are the schema
#   supabase/tests/       pgTAP

# local dev tooling fetched by scripts/dev-stack.sh
.tools/

# Generated by `next dev` / `next build` on every run (Next 16 agent rules).
# Regenerated from the installed Next version, so committing it only produces
# churn in a diff nobody wrote.
/AGENTS.md
/CLAUDE.md

# Also generated, and it flip-flops: `next dev` writes a reference to
# .next/dev/types/, `next build` writes .next/types/. Committing it means every
# build dirties the tree with a one-line diff nobody made — including the build
# `pnpm test:e2e` runs. Nothing needs it in git: it is rewritten from the
# installed Next version, and `tsc --noEmit` passes without it.
/next-env.d.ts
