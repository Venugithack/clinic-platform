node_modules/
.next/
out/
data/*.db
data/*.db-shm
data/*.db-wal
.env
.env.local
*.tsbuildinfo
npm-debug.log*

# Reference copies kept beside the app, not part of it: the hospital
# prototype this UI was adapted from, and the static HTML mockups.
/hospital al in one platform/
/clinic-ui-concept/

# The SQLite database this app used before it moved to Postgres.
/data/

# Database dumps and env backups. The repository is PUBLIC — the previous
# root .gitignore covered these and the app-level one did not, so promoting
# this app to the root very nearly committed four clinic dumps.
/.backups/
*.bak
.env*.bak

# Supabase CLI scratch state ONLY. .temp/pooler-url holds a working database
# credential and this repository is PUBLIC, so these two stay out — but the
# rest of /supabase/ is the backend itself (migrations and edge functions) and
# belongs in the repository. The old rule ignored the whole directory, which
# was correct for the app that kept its schema in lib/server/db.ts and quietly
# untracked the entire backend of the one that replaced it.
/supabase/.temp/
/supabase/.branches/

# Build output
/out/
/.open-next/
