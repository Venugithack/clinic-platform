node_modules/
.next/
out/
.wrangler/
.claude/
.env
.env.local
*.tsbuildinfo
npm-debug.log*

# Local-only retired projects, mockups, databases, dumps, and environment
# backups live here. The repository is PUBLIC, so none of this is committed.
/archive/local/
*.db
*.db-shm
*.db-wal
*.sql.gz
# The whole backup tree, not just the dump extensions. db-backup.sh encrypts to
# `.sql.gz.age`, which `*.sql.gz` does not match — the pattern is an extension,
# and that filename ends in `.age`. This repository is PUBLIC.
/.backups/
*.age
*.dump
*.bak
.env*.bak

# Supabase CLI scratch state ONLY. .temp/pooler-url holds a working database
# credential and this repository is PUBLIC, so these two stay out — but the
# rest of /supabase/ is the backend itself (migrations and edge functions) and
# belongs in the repository. The old rule ignored the whole directory, which
# was correct for the app that kept its schema in lib/server/db.ts and quietly
# untracked the entire backend of the one that replaced it.
/supabase/.temp/
/supabase/.branches/

# Build output
/.open-next/

# `deno check` writes this when the Edge Function typecheck is run locally
# through `npm exec deno@...`. Deno is not a dependency of this repository and
# CI checks without a lockfile, so an unmanaged one here would only drift.
deno.lock

# The earlier prototype, kept locally for comparison.
#
# `AGENTS.md` and `docs/README.md` both refer to it as a reference that exists
# only "when that local reference folder is present", which is exactly what it
# is: somebody's copy of the retired hospital application, sitting beside this
# one so the two interfaces can be read side by side.
#
# It is a gigabyte, fourteen thousand files, and 375MB of its own node_modules,
# and THIS REPOSITORY IS PUBLIC. It is also another project's source: not ours
# to publish. `tsconfig.json` already excludes it from the typecheck, where it
# was contributing 485 errors; this keeps it out of the history as well.
/hospital al in one platform/
