{
  // How Cloudflare serves the static export. HOSTING.md §2.
  //
  // Deliberately the only host-specific file in the repository, and deliberately
  // NOT inside next.config.ts — which says why: the moment the Next build grows
  // host configuration, §7's one-day exit ramp stops being a configuration
  // change. `next build` still writes plain files to `out/`, and Netlify, a
  // Mumbai VPS or an S3 bucket serve that same directory unchanged. Leaving
  // Cloudflare is deleting this file.
  //
  // There is no `main` and no Worker script. Nothing runs on request — the app
  // is 28 prerendered pages that talk to Supabase directly from the browser
  // under RLS, so a Worker would have nothing to do. That also steps around the
  // two ceilings HOSTING.md §2 was written under, a Worker's 3 MiB compressed
  // bundle and its 10 ms CPU budget: neither applies to a file.
  "name": "clinic-platform",
  "compatibility_date": "2026-08-24",

  "assets": {
    "directory": "./out",

    // A 404, not the app.
    //
    // The alternative, "single-page-application", answers every unknown path
    // with index.html and a 200. That would put the lock screen behind a
    // mistyped URL and tell the tablet the request succeeded — and the five
    // screens that take their id from the query string are real prerendered
    // routes (/consult, /patient, /rx/print), not client-side ones, so nothing
    // here needs a fallback to work.
    "not_found_handling": "404-page"
  }
}
