{
  "name": "jayamurugan-clinic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "wrangler dev --ip 0.0.0.0 --port 3000",
    "preview": "wrangler dev --ip 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/password.test.ts tests/order-status.test.ts",
    "test:db": "node --import ./tests/support/register.mjs --test --test-concurrency=1 \"tests/characterization/*.test.mjs\"",
    "test:browser": "node scripts/staging/browser-gate.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "staging:up": "node scripts/staging/up.mjs",
    "staging:down": "node scripts/staging/down.mjs",
    "staging:destroy": "node scripts/staging/down.mjs --destroy",
    "staging:drill": "node scripts/staging/restore-drill.mjs",
    "staging:rehearse": "node scripts/staging/migration-rehearsal.mjs"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "agent-browser": "^0.35.1",
    "csv-parse": "^6.1.0",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "wrangler": "^4.127.1"
  }
}
