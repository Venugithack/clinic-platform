# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so nothing real belongs here.

# ── THE DATABASE ─────────────────────────────────────────────────────────────
#
# The clinic's hosted Postgres. Supabase dashboard -> Project Settings ->
# Database -> Connection string -> URI, Session pooler tab.
#
# The application creates and uses its own `jmc` schema inside this database,
# because `public` belongs to the previous application and eight table names
# collide with this one's. Nothing here reads or writes `public`.
#
# A password containing @ / # or ? must be percent-encoded (@ becomes %40), or
# use scripts/set-db-url.mjs which handles it.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── SESSIONS ─────────────────────────────────────────────────────────────────
#
# What session tokens are hashed with. Generate 32 random bytes. The app refuses
# to start in production without it rather than fall back to a known value.
CLINIC_SESSION_SECRET=replace-with-32-random-bytes

# ── FIRST RUN ────────────────────────────────────────────────────────────────
#
# The administrator's PIN, set once when the database is first seeded, so you
# are not hunting a server log to get in. The other seeded staff get random PINs
# printed once at that moment; the administrator sets real ones from the Staff
# screen. Ignored on every start after the first.
CLINIC_ADMIN_PIN=

# ── WHATSAPP ─────────────────────────────────────────────────────────────────
#
# Complete the Meta setup later. Until all values exist the application keeps
# real send controls disabled and never reports a message as sent — drafting
# still works. See docs/WHATSAPP.md for which of these the clinic actually
# needs, and for the reactive-bot route that avoids most of the paperwork.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
