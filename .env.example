# Local development against Supabase in Docker (HOSTING.md §1a: build local
# first, choose hosting after). `supabase start` prints these values.
#
# Nothing here is a production secret and nothing production-shaped belongs in
# this file — the clinic's keys live in the deployment environment, and the
# client owns them (PLAN.md §19, sole-developer bus factor).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The real key, as printed by `supabase start` — not a hand-minted JWT.
#
# This used to need a token carrying `role: authenticated`, because nothing
# called signIn and every grant targets that role. It no longer does: the
# device signs in anonymously on its first request (lib/db/index.ts), so an
# ordinary key is correct here and the same code runs against a hosted project.
#
# On a hosted project this is the PUBLISHABLE key (`sb_publishable_…`) from
# Settings → API Keys. The legacy `anon` JWT still works but Supabase deprecates
# it at the end of 2026, and this clinic will outlive that.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Selects lib/realtime's WebSocket adapter (LISTEN/NOTIFY over the dev API)
# instead of Supabase Realtime. Set locally by scripts/dev-stack.sh; leave it
# UNSET in production, where Supabase Realtime is the adapter (HOSTING.md §7).
NEXT_PUBLIC_REALTIME_WS_URL=

# The hostname the tablets use on the clinic Wi-Fi. Must be the name on the
# mkcert certificate, not an IP: a service worker will not register over
# http://192.168.x.x and neither will the camera (BUILD.md §1.3).
CLINIC_LAN_HOST=clinic.local
