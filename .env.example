# Local development against Supabase in Docker (HOSTING.md §1a: build local
# first, choose hosting after). `supabase start` prints these values.
#
# Nothing here is a production secret and nothing production-shaped belongs in
# this file — the clinic's keys live in the deployment environment, and the
# client owns them (PLAN.md §19, sole-developer bus factor).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The hostname the tablets use on the clinic Wi-Fi. Must be the name on the
# mkcert certificate, not an IP: a service worker will not register over
# http://192.168.x.x and neither will the camera (BUILD.md §1.3).
CLINIC_LAN_HOST=clinic.local
