# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so nothing real belongs here.

# Public base URL for the deployed Edge Functions. Next.js embeds this value
# into the static JavaScript bundle at build time. A build made without it will
# send API requests to the static frontend host, where no API exists.
NEXT_PUBLIC_FUNCTIONS_URL=https://PROJECT.supabase.co/functions/v1

# ── THE DATABASE ─────────────────────────────────────────────────────────────
#
# Optional connection string for manual CLI or psql maintenance. The deployed
# application does not read DATABASE_URL; Supabase injects SUPABASE_DB_URL into
# the Edge Functions.
#
# The application creates and uses its own `jmc` schema inside this database,
# because `public` belongs to the previous application and eight table names
# collide with this one's. Nothing here reads or writes `public`.
#
# A password containing @ / # or ? must be percent-encoded (@ becomes %40), or
# use scripts/set-db-url.mjs which handles it.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── SESSIONS ─────────────────────────────────────────────────────────────────
#
# What session tokens are hashed with. Generate 32 random bytes. Required — the
# functions refuse to start without it rather than fall back to a known value,
# everywhere, not only in production. Set it on the deployed functions too
# (`supabase secrets set CLINIC_SESSION_SECRET=...`); an Edge Function does not
# read this file.
CLINIC_SESSION_SECRET=replace-with-32-random-bytes

# ── FIRST RUN ────────────────────────────────────────────────────────────────
#
# No environment value is needed. On an empty database, the lock screen creates
# the first administrator and asks for the initial PIN directly.

# ── WHATSAPP ─────────────────────────────────────────────────────────────────
#
# Complete the Meta setup later. The first four are all-or-nothing: until every
# one of them exists the provider adapter is fully disabled, the `whatsapp`
# webhook refuses every request including a correctly signed one, and every
# automatically scheduled message is suppressed into the admin's queue with
# `channel_not_configured` against it rather than being silently dropped. There
# is no partial mode and no development default.
#
# An Edge Function does not read this file — these go on the deployed functions
# with `supabase secrets set`. See docs/reference/WHATSAPP.md for which of them
# the clinic actually needs and for the reactive-bot route that avoids most of
# the paperwork, and docs/operations/ROLLOUT.md §9 for the order to do it in.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0

# ── THE DISPATCH WORKER ──────────────────────────────────────────────────────
#
# One long random string, held by whatever calls /functions/v1/worker on a
# schedule. It is NOT a staff credential: nobody signs in with it, it goes on no
# tablet, and a staff session is refused at that endpoint exactly as an
# anonymous caller is.
#
# Unset means the endpoint refuses everybody, including a correct caller. That
# is deliberate — an unset secret must never mean "no check" — and it is the
# state the clinic is in today, because no scheduler exists yet.
CLINIC_WORKER_TOKEN=

# ── THE ONE LINK A MESSAGE MAY CARRY ─────────────────────────────────────────
#
# Optional. The only destination an approved template may interpolate. A
# template using {{link}} is suppressed with `link_destination_unavailable`
# while this is unset.
CLINIC_PUBLIC_PAGE_URL=
